# Local RAGFlow endpoint. The adapter adds /api/v1; do not include it here.
RAGFLOW_BASE_URL=http://localhost:9380
RAGFLOW_API_KEY=
RAGFLOW_DATASET_NAME=deval-poc
# Official TEI CPU model started by ragflow-compose.sh.
RAGFLOW_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5@Builtin
# Local Ollama model; configure the Ollama provider at this label before live tests.
RAGFLOW_LLM_MODEL=qwen2.5:0.5b@local@Ollama
RAGFLOW_CHUNK_METHOD=naive
RAGFLOW_CHUNK_TOKEN_NUM=512
RAGFLOW_DELIMITER=\n
RAGFLOW_REGISTRY_PATH=.data/registry.sqlite3
RAGFLOW_REQUEST_TIMEOUT=30
RAGFLOW_PARSE_TIMEOUT=1800
RAGFLOW_CANCEL_TIMEOUT=60
RAGFLOW_POLL_INTERVAL=2
RAGFLOW_MAX_DOCUMENT_PAGES=2000
RAGFLOW_MAX_DOCUMENT_BYTES=52428800
RAGFLOW_MAX_TEXT_CHARS=20000000
RAGFLOW_CITATION_THRESHOLD=0.60
RAGFLOW_RECONCILE_MAX_PAGES=20
RAGFLOW_GRAPH_TIMEOUT=1800
DEVAL_MODEL_CONFIG=config/models.json
RUN_LIVE_RAGFLOW_TESTS=false
